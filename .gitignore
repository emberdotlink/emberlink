/target
.emberlink/
memory/
*.key
*.pem
*.p12
*.pfx
# Allow PEM/KEY test fixtures under crates/<crate>/tests/fixtures/. Path is
# covered by the .gitleaks.toml allowlist (`crates/.+/tests/fixtures/.+`),
# so the BEGIN PRIVATE KEY markers in these fixtures don't trip the
# public-mirror sync gate.
!crates/*/tests/fixtures/*.pem
!crates/*/tests/fixtures/*.key

# Sync-to-public operator-only secrets file (implementation-note-1).
# The .example schema IS committed; the actual sync-secrets.env (with real
# names / emails / financial figures) MUST NOT commit. Defense-in-depth:
# scripts/sync-to-public/** is also denylisted in deny-paths.txt, so even
# if this gitignore line is removed the file won't ship to the public mirror.

.headless-control
.headless-metrics.jsonl
.headless-ready-queue.json
.headless-inflight.json
.headless-events.jsonl
.headless-failures.jsonl
.demo-test-outcomes.jsonl
.demo-test-blockers.txt
docs/operations/*.results.jsonl
.ember/runtime/
**/.ember/runtime/
ember-ext/extension/pkg/
web/node_modules/
node_modules/
packages/*/node_modules/
web/dist/
.playwright-cli/
demo/screenshots/
build/
!docs/public-site/build/
!docs/public-site/build/*.md
!public-docs/build/
!public-docs/build/*.md
infra/pulumi/codegen/helm-values-cache/
