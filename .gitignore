# Allow PEM/KEY test fixtures under crates/<crate>/tests/fixtures/. Path is
# covered by the .gitleaks.toml allowlist (`crates/.+/tests/fixtures/.+`),
# so the BEGIN PRIVATE KEY markers in these fixtures don't trip the
# public-mirror sync gate.
!crates/*/tests/fixtures/*.pem
!crates/*/tests/fixtures/*.key

# Public trust-anchor certificates embedded into the daemon binary via
# include_str! (e.g. the Yubico PIV Root CA, ADR 200 / P23). These are PUBLIC
# root certs (no private key), fingerprint-pinned in source + asserted by test;
# the `*.pem` ignore above would otherwise silently drop them on `git add`,
# which broke the build on main (the cert in #5037 was never committed).
!crates/*/src/**/certs/*.pem

